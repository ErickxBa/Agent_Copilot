# Option A (default): local Ollama. Inference stays on this machine.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1
OPENAI_TIMEOUT_SECONDS=120
ALLOW_REMOTE_ENDPOINT=false

# Option B: GroqCloud OpenAI-compatible endpoint.
# Create an API key in your GroqCloud account. To switch, replace the active
# local values above with these values. Free-tier access, model availability,
# and rate limits depend on your account and may change. Exception records
# leave this machine when sent to the remote endpoint.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=replace-with-your-groq-api-key
# OPENAI_MODEL=openai/gpt-oss-20b
# ALLOW_REMOTE_ENDPOINT=true

# Do not commit .env or send real financial data to an unapproved provider.
